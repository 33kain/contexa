# secrets — never commit
key.txt
*.key
.env
.env.*
.dev.vars

# wrangler
.wrangler/
wrangler.toml.bak

# node
node_modules/
npm-debug.log*

# build artifacts
*.zip
build-ready/

# dogfood output. scripts/dogfood-test.ps1 writes contexa-test-<tag>.txt beside
# itself on every run, so these accumulate one per run and are pure output — the
# session that produced them is in the changelog, not in a tracked file. Ignored
# rather than committed because release-commit.ps1 stages with `git add -A`,
# which would otherwise sweep whatever run happened last into the release commit.
scripts/contexa-test-*.txt

# os
.DS_Store
Thumbs.db
desktop.ini

# playwright mcp scratch (created by the .mcp.json browser server)
.playwright-mcp/
